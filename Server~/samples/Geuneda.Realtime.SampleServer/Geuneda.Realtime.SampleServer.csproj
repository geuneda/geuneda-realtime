<Project Sdk="Microsoft.NET.Sdk.Web">
  <!--
    Unity 테스트의 상호 운용 계약(Tests/EditMode/Interop/ISampleRpc.cs)을 그대로 컴파일하는 샘플 서버.
    게임 서버도 같은 방식으로 Unity 프로젝트의 계약 폴더를 링크하고 생성기를 analyzer 로 참조한다.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Geuneda.Realtime.SampleServer</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(RealtimeTestsDir)EditMode/Interop/*.cs" LinkBase="Contracts" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Geuneda.Realtime.Server/Geuneda.Realtime.Server.csproj" />
    <ProjectReference Include="../../src/Geuneda.Realtime.Generator/Geuneda.Realtime.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
